<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.statusoverlay"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <!-- Доступ в сеть для WebSocket-соединения -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Рисование поверх других приложений (оверлей) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Уведомления (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Запуск foreground-сервиса -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- КРИТИЧНО: Разрешение на фоновый захват экрана для Android 10+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <permission
        android:name="com.example.statusoverlay.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.example.statusoverlay.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Status Overlay Demo"
        android:testOnly="true"
        android:theme="@style/Theme.StatusOverlay"
        android:usesCleartextTraffic="true" >
        <activity
            android:name="com.example.statusoverlay.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- КРИТИЧНО: Указываем через "|" комбинированный тип сервиса -->
        <service
            android:name="com.example.statusoverlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProjection" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.example.statusoverlay.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>