<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Доступ в сеть для WebSocket-соединения -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Рисование поверх других приложений (оверлей) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Уведомления (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Запуск foreground-сервиса -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- КРИТИЧНО: Разрешение на фоновый захват экрана для Android 10+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Status Overlay Demo"
        android:theme="@style/Theme.StatusOverlay"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- КРИТИЧНО: Указываем через "|" комбинированный тип сервиса -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProjection" />

    </application>

</manifest>
